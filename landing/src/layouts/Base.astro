---
import "@/styles/global.css";
import Icon from "@/components/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  article?: { publishedTime: string; modifiedTime?: string };
}

const {
  title = "Rockola digital con QR para bares en Colombia | Repítela",
  description = "Repítela es una rockola digital con QR para bares en Colombia. Tus clientes piden canciones desde el celular y tú controlas la cola. $50.000 COP/mes.",
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = "https://repitela.com/og-repitela.jpg",
  noindex = false,
  article,
} = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PPVKNTZB');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Repítela" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-CO" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Repítela" />
    <meta property="og:locale" content="es_CO" />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article && <meta property="article:author" content="Repítela" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- PWA / Mobile -->
    <meta name="theme-color" content="#FF5522" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Repítela" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <slot name="head" />
  </head>

  <body class="min-h-screen bg-background text-foreground overflow-x-hidden selection:bg-primary/30 selection:text-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PPVKNTZB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <!-- Global lead dialog, opened from CTAs across the page via [data-open-lead] -->
    <dialog id="lead-dialog" class="glass-card bg-brand-card/95 border border-white/15 rounded-2xl" aria-labelledby="lead-dialog-title">
      <form id="lead-form" class="p-6 space-y-3">
        <div class="flex items-start justify-between gap-4 mb-1">
          <div>
            <h2 id="lead-dialog-title" class="text-xl font-black text-white font-display">Pide una demo de Repítela</h2>
            <p class="text-muted-foreground text-sm mt-1">
              Cuéntanos sobre tu bar. Te escribimos por WhatsApp para mostrarte la demo y el plan de $50.000 COP al mes.
            </p>
          </div>
          <button type="button" data-close-lead aria-label="Cerrar" class="text-zinc-400 hover:text-white shrink-0 p-1 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
            <Icon name="x" class="w-5 h-5" />
          </button>
        </div>

        <div>
          <label for="lead-nombre" class="sr-only">Tu nombre</label>
          <input id="lead-nombre" name="nombre" autocomplete="name" required placeholder="Tu nombre" class="flex h-12 w-full rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-base text-white placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm" />
        </div>
        <div>
          <label for="lead-bar" class="sr-only">Nombre del bar</label>
          <input id="lead-bar" name="bar" autocomplete="organization" required placeholder="Nombre del bar" class="flex h-12 w-full rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-base text-white placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm" />
        </div>
        <div>
          <label for="lead-ciudad" class="sr-only">Ciudad</label>
          <input id="lead-ciudad" name="ciudad" autocomplete="address-level2" required placeholder="Ciudad" class="flex h-12 w-full rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-base text-white placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm" />
        </div>
        <div>
          <label for="lead-direccion" class="sr-only">Dirección del bar</label>
          <input id="lead-direccion" name="direccion" autocomplete="street-address" required placeholder="Dirección del bar" class="flex h-12 w-full rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-base text-white placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm" />
        </div>

        <button type="submit" class="inline-flex items-center justify-center gap-2 h-11 w-full bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold py-6 rounded-xl shadow-lg transition-all hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-emerald-500/40">
          <Icon name="message-circle" class="h-5 w-5 shrink-0" />
          Enviar
        </button>
      </form>
    </dialog>

    <script>
      import "@/scripts/site";
    </script>
  </body>
</html>
