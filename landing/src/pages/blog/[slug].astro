---
import Base from "@/layouts/Base.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import FloatingWhatsApp from "@/components/FloatingWhatsApp.astro";
import Icon from "@/components/Icon.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import { readingTime } from "@/lib/reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const ogImage = await getImage({
  src: post.data.heroImage,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 80,
  fit: "cover",
  position: "bottom",
});
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();
const publishedIso = post.data.pubDate.toISOString();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const minutes = readingTime(post.body ?? "");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: "https://repitela.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: "https://repitela.com/blog/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: canonical,
        },
      ],
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#article`,
      headline: post.data.title,
      description: post.data.description,
      image: [ogImageUrl],
      datePublished: publishedIso,
      dateModified: publishedIso,
      inLanguage: "es-CO",
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      author: {
        "@type": "Organization",
        name: "Repítela",
        url: "https://repitela.com/",
        description: "Plataforma de rockola digital interactiva con QR para bares y gastrobares en Colombia.",
      },
      publisher: {
        "@type": "Organization",
        name: "Repítela",
        url: "https://repitela.com/",
        logo: { "@type": "ImageObject", url: "https://repitela.com/og-repitela.jpg" },
      },
    },
  ],
};

const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(canonical);
---

<Base
  title={`${post.data.title} | Repítela`}
  description={post.data.description}
  ogImage={ogImageUrl}
  article={{ publishedTime: publishedIso }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar />

  <main class="min-h-screen pb-20">
    <div class="relative w-full min-h-[180px] aspect-[21/9] max-h-[220px] sm:max-h-[320px] overflow-hidden">
      <Image
        src={post.data.heroImage}
        alt={post.data.heroImageAlt}
        widths={[480, 768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-[center_80%]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-background/10"></div>
      <div class="absolute top-0 left-0 w-1/2 h-1/2 bg-gradient-to-br from-black via-black/85 via-55% to-transparent pointer-events-none"></div>
    </div>
    <div class="h-16 sm:h-24 -mt-16 sm:-mt-24 relative bg-gradient-to-t from-background to-transparent pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 max-w-5xl -mt-4 sm:-mt-20 relative z-10">
      <nav aria-label="Breadcrumb" class="text-sm text-zinc-400 mb-6 pt-6 sm:pt-0">
        <a href="/blog/" class="text-orange-400 hover:text-orange-300">Blog</a>
        <span class="mx-1.5">/</span>
        <span class="text-zinc-300">{post.data.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-10 lg:gap-14">
        <div class="min-w-0">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">{post.data.title}</h1>
          <div class="flex items-center gap-2 text-sm text-zinc-400 mb-8 sm:mb-10">
            <span>{post.data.pubDate.toLocaleDateString("es-CO", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</span>
            <span aria-hidden="true">·</span>
            <span>{minutes} min de lectura</span>
          </div>

          <article class="prose-blog text-zinc-200">
            <Content />
          </article>
        </div>

        <aside class="lg:pt-1 space-y-6">
          <div class="glass-card rounded-2xl p-5 border border-white/15">
            <p class="text-xs uppercase tracking-wide text-zinc-400 font-bold mb-3">Escrito por</p>
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-primary/20 border border-primary/40 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="sparkles" class="w-5 h-5 text-orange-400" />
              </div>
              <div>
                <div class="text-sm font-bold text-white">Repítela</div>
                <div class="text-xs text-orange-400 font-semibold mb-1">Rockola digital con QR</div>
                <p class="text-xs text-zinc-300 leading-relaxed">
                  Plataforma colombiana de entretenimiento musical interactivo para bares y gastrobares.
                </p>
              </div>
            </div>
          </div>

          <div class="glass-card rounded-2xl p-5 border-2 border-primary/40 shadow-glow-primary text-center">
            <Icon name="sparkles" class="w-6 h-6 text-orange-400 mx-auto mb-2" />
            <p class="text-sm font-bold text-white mb-1">¿Quieres esto en tu bar?</p>
            <p class="text-xs text-zinc-400 mb-4">Pide una demo gratis por WhatsApp.</p>
            <button
              type="button"
              data-open-lead="blog_post"
              class="inline-flex items-center justify-center gap-2 h-10 w-full bg-gradient-to-r from-primary to-orange-500 hover:opacity-90 text-white font-bold text-sm rounded-xl shadow-glow-primary transition-all hover:shadow-lg"
            >
              <Icon name="sparkles" class="w-3.5 h-3.5" />
              Pide una demo
            </button>
          </div>

          <div class="glass-card rounded-2xl p-5 border border-white/15">
            <p class="text-xs uppercase tracking-wide text-zinc-400 font-bold mb-4">Comparte este artículo</p>
            <div class="flex items-center gap-2">
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir en Facebook"
                class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center hover:bg-white/20 transition-colors text-zinc-200"
              >
                <Icon name="facebook" class="w-4 h-4" />
              </a>
              <a
                href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir en X"
                class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center hover:bg-white/20 transition-colors text-zinc-200"
              >
                <Icon name="x" class="w-4 h-4" />
              </a>
              <a
                href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir por WhatsApp"
                class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center hover:bg-white/20 transition-colors text-zinc-200"
              >
                <Icon name="message-circle" class="w-4 h-4" />
              </a>
              <button
                type="button"
                id="copy-link"
                data-url={canonical}
                aria-label="Copiar enlace"
                class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center hover:bg-white/20 transition-colors text-zinc-200"
              >
                <Icon name="link" class="w-4 h-4" />
              </button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />

  <script>
    const btn = document.getElementById("copy-link");
    btn?.addEventListener("click", async () => {
      const url = btn.dataset.url;
      if (!url) return;
      await navigator.clipboard.writeText(url);
      const original = btn.innerHTML;
      btn.textContent = "✓";
      setTimeout(() => { btn.innerHTML = original; }, 1500);
    });
  </script>
</Base>
