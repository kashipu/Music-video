---
import Icon from "@/components/Icon.astro";
import logo from "@/assets/logo-color-negativo.svg";
---

<footer class="border-t border-white/15 py-12 sm:py-16 bg-brand-darker relative z-10">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 pb-10 border-b border-white/10">
      <div class="text-center sm:text-left">
        <img src={logo.src} alt="Repítela" width="128" height="32" class="h-8 w-auto mx-auto sm:mx-0" />
        <span class="text-xs text-zinc-300 font-medium tracking-wide block">Rockola digital con QR para bares</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-zinc-200 font-medium">
        <a href="/#como-funciona" class="hover:text-white transition-colors">Cómo funciona</a>
        <a href="/#para-bares" class="hover:text-white transition-colors">Para bares</a>
        <a href="/#precio" class="hover:text-white transition-colors">Precio</a>
        <a href="/#faq" class="hover:text-white transition-colors">Preguntas</a>
        <a href="https://app.repitela.com/admin" target="_blank" rel="noopener noreferrer" class="hover:text-orange-400 transition-colors">Panel</a>
      </div>

      <div class="flex items-center gap-3 text-xs font-semibold text-zinc-100">
        <a
          href="https://instagram.com/repitela.musica"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 glass-card bg-white/10 border-white/20 px-4 py-2.5 rounded-xl hover:text-white hover:border-primary/50 transition-colors"
        >
          <Icon name="instagram" class="h-4 w-4 text-orange-400" />
          @repitela.musica
        </a>
        <a
          href="https://wa.me/573028336170"
          target="_blank"
          rel="noopener noreferrer"
          data-track-location="footer"
          class="flex items-center gap-2 glass-card bg-white/10 border-white/20 px-4 py-2.5 rounded-xl hover:text-white hover:border-emerald-500/50 transition-colors"
        >
          <Icon name="message-circle" class="h-4 w-4 text-emerald-400" />
          WhatsApp
        </a>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-300 gap-4 text-center sm:text-left font-medium">
      <div>© {new Date().getFullYear()} Repítela. Todos los derechos reservados.</div>
      <div class="flex items-center gap-2 text-zinc-200">
        <span>Hecho con pasión en Colombia 🇨🇴</span>
      </div>
    </div>
  </div>
</footer>
