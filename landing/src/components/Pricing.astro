---
import Icon from "@/components/Icon.astro";

const features = [
  "Canciones y búsquedas ilimitadas en YouTube",
  "Pantalla para tus televisores",
  "Cola de canciones en tiempo real",
  "Panel de control desde celular o computador",
  "Música automática cuando no hay pedidos",
  "Anuncios para promocionar productos del bar",
  "Datos de canciones y horarios de mayor actividad",
  "Códigos QR personalizados para imprimir",
  "Límites por mesa y PIN opcional",
  "Soporte por WhatsApp",
];
---

<section id="precio" class="py-20 sm:py-28 relative overflow-hidden">
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 glass-card px-4 py-1.5 rounded-full text-xs font-bold text-orange-400 mb-4 border border-primary/30">
        <Icon name="sparkles" class="w-3.5 h-3.5 text-amber-400" />
        Un plan simple
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 leading-tight text-white">
        Un precio fijo. <span class="text-gradient">Todo incluido.</span>
      </h2>
      <p class="text-zinc-200 text-base sm:text-lg max-w-xl mx-auto font-medium">
        Tus clientes piden canciones gratis desde el celular. Tú pagas $50.000 COP al mes, sin contratos ni comisiones.
      </p>
    </div>

    <div data-animate class="max-w-lg mx-auto">
      <div class="glass-card rounded-3xl sm:rounded-[2.5rem] p-6 sm:p-10 md:p-12 border-2 border-primary/50 shadow-glow-primary relative overflow-hidden">
        <div class="text-center mb-8">
          <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-500/40 rounded-full px-4 py-1.5 mb-6 text-emerald-300 text-xs font-bold max-w-full">
            <Icon name="shield-check" class="h-4 w-4 text-emerald-400 shrink-0" />
            <span>Sin permanencia. Cancela cuando quieras.</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-1 font-display">Repítela para tu bar</h3>
          <p class="text-xs sm:text-sm text-zinc-300 mb-6 font-medium">Rockola digital con QR, control y música de respaldo</p>

          <div class="flex items-baseline justify-center gap-1.5">
            <span class="text-5xl sm:text-6xl font-black text-white tracking-tight font-display">$50.000</span>
            <span class="text-lg sm:text-xl font-bold text-orange-400">COP /mes</span>
          </div>
          <p class="text-xs text-zinc-300 mt-2 font-medium">Aproximadamente $1.667 al día</p>
        </div>

        <div class="space-y-3.5 mb-10 py-6 border-y border-white/15">
          {features.map((f) => (
            <div class="flex items-center gap-3 text-sm text-zinc-100 font-medium">
              <div class="w-5 h-5 rounded-full bg-emerald-500/25 text-emerald-400 flex items-center justify-center shrink-0">
                <Icon name="check" class="h-3.5 w-3.5 stroke-[3]" />
              </div>
              <span>{f}</span>
            </div>
          ))}
        </div>

        <a
          href="https://wa.me/573028336170?text=Hola%2C%20quiero%20activar%20Repitela%20en%20mi%20bar%20por%2050.000%20al%20mes"
          target="_blank"
          rel="noopener noreferrer"
          data-track-location="pricing"
          class="inline-flex items-center justify-center gap-2.5 h-11 w-full bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold text-base md:text-lg py-6 sm:py-7 rounded-2xl shadow-lg transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          <Icon name="message-circle" class="h-5 w-5 shrink-0" />
          Pide una demo
        </a>
      </div>
    </div>
  </div>
</section>
