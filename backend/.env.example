APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=true

DATABASE_PATH=data/barqueue.db

YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=
BREVO_API_KEY=
EMAIL_FROM=no-reply@repitela.com
FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173

MAX_SONGS_PER_WINDOW=5
WINDOW_MINUTES=30

JWT_EXPIRATION_HOURS=24
JWT_ADMIN_EXPIRATION_HOURS=8

# Default true. En producción usa false para deshabilitar temporalmente el registro con Google.
GOOGLE_SIGNUP_ENABLED=true
# Default true. En producción usa false para deshabilitar temporalmente el checkout de Wompi.
WOMPI_CHECKOUT_ENABLED=true
